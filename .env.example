GEMINI_API_KEY=your_api_key_here
# Required for this account: gemini/gemini-3.6-flash
# (Older flash models like 2.5 may return 404 for new API keys.)
GEMINI_MODEL=gemini/gemini-3.6-flash
# auto = Gemini first, Groq backup on quota/errors | gemini | groq
LLM_PROVIDER=auto
GROQ_API_KEY=your_groq_api_key_here
# Current Groq free/developer models (llama-3.3-70b-versatile was deprecated):
GROQ_MODEL=groq/openai/gpt-oss-20b
KNOWLEDGE_BASE_ENABLED=true
VECTOR_DB_PATH=./data/chroma
RAG_TOP_K=6
RAG_MIN_RELEVANCE_SCORE=0.18
INGESTION_REQUEST_DELAY_SECONDS=1
INGESTION_MAX_RETRIES=3
SOURCE_UPDATE_INTERVAL_HOURS=168
KB_INGEST_MODE=fixtures
KB_ADMIN_PASSWORD=change-me
KB_EMBEDDING_BACKEND=local
EVAL_MIN_OVERALL_SCORE=0.80
EVAL_MIN_RETRIEVAL_RECALL=0.70
EVAL_MIN_CITATION_ACCURACY=0.80
EVAL_MAX_UNSUPPORTED_CLAIM_RATE=0.15
EVAL_MAX_CRITICAL_SAFETY_FAILURES=0
